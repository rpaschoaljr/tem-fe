{
  "name": "tem-fe",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "emulators": "docker compose up --build -d firebase-emulators",
    "emulators:logs": "docker compose logs -f firebase-emulators",
    "emulators:stop": "docker compose down",
    "seed": "node scripts/seed-emulator.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "scan:snyk": "npx snyk test",
    "scan:checkov": "docker run --rm -v \"$PWD:/tf\" bridgecrew/checkov -d /tf",
    "scan:secrets": "docker run --rm -v \"$PWD:/path\" zricethezav/gitleaks:latest detect --source=\"/path\" -v",
    "scan:owasp": "docker run --rm --network host ghcr.io/zaproxy/zaproxy:stable zap-baseline.py -t http://localhost:4200",
    "scan:owasp-full": "docker run --rm --network host ghcr.io/zaproxy/zaproxy:stable zap-full-scan.py -t http://localhost:4200",
    "scan:nuclei": "docker run --rm --network host projectdiscovery/nuclei:latest -u http://localhost:4200",
    "scan:all": "npm run scan:snyk && npm run scan:checkov && npm run scan:secrets && npm run scan:owasp && npm run scan:nuclei"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.0.2",
    "@angular/cdk": "22.0.2",
    "@angular/common": "22.0.2",
    "@angular/compiler": "22.0.2",
    "@angular/core": "22.0.2",
    "@angular/fire": "21.0.0-rc.0",
    "@angular/forms": "22.0.2",
    "@angular/material": "22.0.2",
    "@angular/platform-browser": "22.0.2",
    "@angular/platform-browser-dynamic": "22.0.2",
    "@angular/router": "22.0.2",
    "chart.js": "4.5.1",
    "firebase": "^12.15.0",
    "ng2-charts": "10.0.0",
    "ngx-image-cropper": "9.1.6",
    "rxjs": "7.8.0",
    "tslib": "2.3.0",
    "xlsx": "0.18.5",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "22.0.3",
    "@angular/compiler-cli": "22.0.2",
    "@types/jasmine": "5.1.0",
    "concurrently": "9.2.1",
    "firebase-tools": "14.27.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "5.9.0",
    "karma": "6.4.0",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.0",
    "karma-firefox-launcher": "2.1.3",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "typescript": "6.0.3",
    "wait-on": "9.0.4"
  },
  "overrides": {
    "@angular/fire": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "@angular/platform-browser": "$@angular/platform-browser",
      "@angular/platform-browser-dynamic": "$@angular/platform-browser-dynamic"
    }
  }
}
