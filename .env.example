# ── Projeto demo-sistematemfe ──
FIREBASE_PROJECT=demo-sistematemfe

# ── Portas dos Emuladores Firebase (Docker/Scripts) ──
FIREBASE_UI_PORT=4000
FIREBASE_HUB_PORT=4400
FIREBASE_AUTH_PORT=9099
FIREBASE_FIRESTORE_PORT=8080
FIREBASE_STORAGE_PORT=9199
FIREBASE_FUNCTIONS_PORT=5001
FIREBASE_HOSTING_PORT=5000

# ── Portas para o Angular (VITE_* expõe automaticamente via import.meta.env) ──
VITE_AUTH_PORT=9099
VITE_FIRESTORE_PORT=8080
VITE_STORAGE_PORT=9199
VITE_FUNCTIONS_PORT=5001

# ── Development ──
NODE_ENV=development
