rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNÇÕES AUXILIARES (APENAS EXPRESSÕES) ---
    
    function isLoggedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isLoggedIn() && request.auth.token.email == 'admin@tem.local';
    }

    function hasPermissionDoc() {
      return exists(/databases/$(database)/documents/permissions/$(request.auth.token.email));
    }

    function getP() {
      return get(/databases/$(database)/documents/permissions/$(request.auth.token.email)).data;
    }

    function hasPerm(module, action) {
      return isLoggedIn() && hasPermissionDoc() && (
        getP().hierarchyLevel >= 10 || 
        (getP().modules.keys().contains(module) && getP().modules[module][action] == true)
      );
    }

    // --- REGRAS POR COLEÇÃO ---

    // Global: Master Admin tem acesso total (essencial para o SEED rodar)
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    match /members/{memberId} {
      allow read: if isMasterAdmin() || (isLoggedIn() && ( (resource != null && resource.data.email == request.auth.token.email) || hasPerm('members', 'read')));
      allow write: if isMasterAdmin() || hasPerm('members', 'write');
    }

    match /transactions/{txId} {
      allow read: if isMasterAdmin() || hasPerm('finance', 'read');
      allow write: if isMasterAdmin() || hasPerm('finance', 'write');
    }

    match /stock/{itemId} {
      allow read: if isMasterAdmin() || hasPerm('stock', 'read');
      allow write: if isMasterAdmin() || hasPerm('stock', 'write');
    }

    match /notices/{noticeId} {
      allow read: if isLoggedIn();
      allow write: if isMasterAdmin() || hasPerm('notices', 'write');
    }

    match /system_configs/{configId} {
      allow read: if isLoggedIn();
      allow write: if isMasterAdmin() || hasPerm('settings', 'read');
    }

    match /permissions/{permId} {
      allow read: if isLoggedIn() && (isMasterAdmin() || permId == request.auth.token.email || permId.startsWith('role_'));
      allow write: if isMasterAdmin();
    }
  }
}
