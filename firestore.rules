rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNÇÕES AUXILIARES ---
    
    function isLoggedIn() {
      return request.auth != null;
    }

    // Admin Mestre (Verifica Claim injetada ou HierarchyLevel)
    function isMasterAdmin() {
      return isLoggedIn() && (request.auth.token.admin == true || (request.auth.token.hierarchyLevel != null && request.auth.token.hierarchyLevel >= 10));
    }

    function hasPerm(module, action) {
      return isLoggedIn() && (
        (request.auth.token.hierarchyLevel != null && request.auth.token.hierarchyLevel >= 10) || 
        (request.auth.token.perms != null && 
         request.auth.token.perms.get(module, {}).get(action, false) == true)
      );
    }

    // --- REGRAS POR COLEÇÃO ---

    // Global: Master Admin tem acesso total
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // 1. MEMBROS - FATIA BÁSICA (Pública para membros logados)
    match /members/{memberId} {
      allow read: if isLoggedIn(); 
      allow write: if hasPerm('members', 'write');
    }

    // 2. MEMBROS - FATIA PRIVADA (CPF, Endereço, Telefone)
    match /members_private/{memberId} {
      // Lê se for Admin OU se for o dono do próprio dado
      allow read: if hasPerm('members', 'read') || (request.auth.uid == memberId) || (resource != null && resource.data.uid == request.auth.uid);
      allow create, delete: if hasPerm('members', 'write');
      allow update: if hasPerm('members', 'write') || request.auth.uid == memberId || (resource != null && resource.data.uid == request.auth.uid);
    }

    // 3. MEMBROS - FATIA ESPIRITUAL (Rituais, Orixás)
    match /members_spiritual/{memberId} {
      // Lê se for Admin OU se for o próprio dono E tiver a flag liberada
      allow read: if hasPerm('members', 'read') || 
                  (((request.auth.uid == memberId) || (resource != null && resource.data.uid == request.auth.uid)) && resource.data.showSpiritualData == true);
      allow write: if hasPerm('members', 'write');
    }

    // --- OUTRAS COLEÇÕES ---

    match /transactions/{txId} {
      allow read: if hasPerm('finance', 'read');
      allow write: if hasPerm('finance', 'write');
    }

    match /scheduled_transactions/{schedId} {
      allow read: if hasPerm('finance', 'read');
      allow write: if hasPerm('finance', 'write');
    }

    match /stock/{itemId} {
      allow read: if hasPerm('stock', 'read');
      allow write: if hasPerm('stock', 'write');
    }

    match /notices/{noticeId} {
      allow read: if isLoggedIn();
      allow write: if hasPerm('notices', 'write');
    }

    match /system_configs/{configId} {
      allow read: if isLoggedIn();
      allow write: if hasPerm('settings', 'write');
    }

    match /permissions/{permId} {
      // Usuário pode ler seu próprio documento de permissão (necessário para fallback)
      allow read: if isMasterAdmin() || (isLoggedIn() && permId == request.auth.uid);
      allow write: if isMasterAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if isMasterAdmin();
      allow write: if false; // Apenas backend escreve
    }
  }
}
