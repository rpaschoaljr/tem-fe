rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- FUNÇÕES AUXILIARES ---
    
    function isLoggedIn() {
      return request.auth != null;
    }

    // Admin Mestre (Acesso total para desenvolvimento)
    function isMasterAdmin() {
      return isLoggedIn() && request.auth.token.email == 'admin@tem.local';
    }

    // Busca as permissões do usuário no banco (Será otimizado para Token depois)
    function getP() {
      return get(/databases/$(database)/documents/permissions/$(request.auth.token.email)).data;
    }

    function hasPerm(module, action) {
      return isLoggedIn() && (
        getP().hierarchyLevel >= 10 || 
        (getP().modules.keys().contains(module) && getP().modules[module][action] == true)
      );
    }

    // --- REGRAS POR COLEÇÃO ---

    // Global: Master Admin tem acesso total
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

    // 1. MEMBROS - FATIA BÁSICA (Pública para membros logados)
    match /members/{memberId} {
      allow read: if isLoggedIn(); 
      allow write: if hasPerm('members', 'write');
    }

    // 2. MEMBROS - FATIA PRIVADA (CPF, Endereço, Telefone)
    match /members_private/{memberId} {
      // Lê se for Admin OU se for o dono do próprio dado
      allow read: if hasPerm('members', 'read') || (resource != null && resource.data.email == request.auth.token.email);
      allow write: if hasPerm('members', 'write');
    }

    // 3. MEMBROS - FATIA ESPIRITUAL (Rituais, Orixás)
    match /members_spiritual/{memberId} {
      // Lê se for Admin OU se for o próprio dono E tiver a flag liberada
      allow read: if hasPerm('members', 'read') || 
                  (resource != null && resource.data.email == request.auth.token.email && resource.data.showSpiritualData == true);
      allow write: if hasPerm('members', 'write');
    }

    // --- OUTRAS COLEÇÕES ---

    match /transactions/{txId} {
      allow read: if hasPerm('finance', 'read');
      allow write: if hasPerm('finance', 'write');
    }

    match /stock/{itemId} {
      allow read: if hasPerm('stock', 'read');
      allow write: if hasPerm('stock', 'write');
    }

    match /notices/{noticeId} {
      allow read: if isLoggedIn();
      allow write: if hasPerm('notices', 'write');
    }

    match /system_configs/{configId} {
      allow read: if isLoggedIn();
      allow write: if hasPerm('settings', 'read');
    }

    match /permissions/{permId} {
      allow read: if isLoggedIn() && (isMasterAdmin() || permId == request.auth.token.email || permId.startsWith('role_'));
      allow write: if isMasterAdmin();
    }
  }
}
