# Eclipse Temurin já inclui Java 21
FROM eclipse-temurin:21-jre-jammy

# Instala Node.js 22
RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Instala firebase-tools globalmente
RUN npm install -g firebase-tools@15.7.0

WORKDIR /app

# Copia arquivos de configuração (raramente mudam)
COPY firebase.json .
COPY firestore.rules .
COPY firestore.indexes.json .
COPY storage.rules .

# Pré-baixa os binários dos emuladores (raramente mudam — cache pesado)
RUN firebase setup:emulators:firestore --project demo-sistematemfe \
    && firebase setup:emulators:storage --project demo-sistematemfe \
    && firebase setup:emulators:ui --project demo-sistematemfe

# Instala dependências das funções (cache separado do source)
COPY functions/package.json functions/package-lock.json ./functions/
RUN cd functions && npm install

# Copia source e compila (muda com frequência — última layer)
COPY functions/tsconfig.json ./functions/
COPY functions/src/ ./functions/src/
RUN cd functions && npm run build

# Portas: UI(4000), Hub(4400), Auth(9099), Firestore(8080), Storage(9199), Functions(5001), Hosting(5000)
EXPOSE 4000 4400 9099 8080 9199 5001 5000

# Inicia todos os emuladores configurados no firebase.json
# Usa FIREBASE_PROJECT do ambiente (definido no docker-compose/.env)
CMD firebase emulators:start --project ${FIREBASE_PROJECT:-demo-sistematemfe}
