# Eclipse Temurin já inclui Java 21
FROM eclipse-temurin:21-jre-jammy

# Instala Node.js 22
RUN apt-get update && apt-get install -y --no-install-recommends curl gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Instala firebase-tools globalmente
RUN npm install -g firebase-tools@15.7.0

WORKDIR /app

# Copia arquivos de configuração
COPY firebase.json .
COPY firestore.rules .
COPY firestore.indexes.json .
COPY storage.rules .

# Copia a pasta das funções para que o emulador possa rodá-las
COPY functions ./functions

# Instala dependências e compila as funções durante o build da imagem
RUN cd functions && npm install && npm run build

# Pré-baixa os binários dos emuladores
RUN firebase setup:emulators:firestore --project sistematemfe
RUN firebase setup:emulators:storage --project sistematemfe
RUN firebase setup:emulators:ui --project sistematemfe

# Portas: UI(4000), Hub(4400), Auth(9099), Firestore(8080), Storage(9199), Functions(5001)
EXPOSE 4000 4400 9099 8080 9199 5001

# Inicia todos os emuladores configurados no firebase.json
CMD ["firebase", "emulators:start", \
     "--project", "sistematemfe", \
     "--import", "/app/emulator-data", \
     "--export-on-exit", "/app/emulator-data"]
